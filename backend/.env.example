# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (e.g. mongodb://localhost:27017/taskmanager or MongoDB Atlas URI)
MONGODB_URI=mongodb://localhost:27017/taskmanager

# Authentication Secrets (Replace in production with 64+ char random secret)
JWT_SECRET=replace_with_a_secure_random_secret_min_32_chars
JWT_EXPIRES_IN=7d

# CORS Allowed Origin (Frontend URL)
CLIENT_URL=http://localhost:5173
