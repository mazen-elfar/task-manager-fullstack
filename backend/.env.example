# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (e.g. mongodb://localhost:27017/taskmanager or MongoDB Atlas URI)
MONGODB_URI=mongodb://localhost:27017/taskmanager

# Authentication Secrets (Replace in production with 64+ char random string)
JWT_SECRET=super_secret_jwt_key_change_in_production_min_32_characters
JWT_EXPIRES_IN=7d

# CORS Allowed Origin (Frontend URL)
CLIENT_URL=http://localhost:5173
