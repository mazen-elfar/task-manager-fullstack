# ==============================================================================
# TaskMaster Monorepo Environment Variables Reference
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (backend/.env)
# ------------------------------------------------------------------------------
# Port the Express server listens on (default: 5000)
PORT=5000

# Runtime environment ('development' | 'production' | 'test')
NODE_ENV=development

# MongoDB Connection String: local instance or MongoDB Atlas cluster URI
MONGODB_URI=mongodb://localhost:27017/taskmanager

# Cryptographically strong secret for signing JWT tokens (min 32 characters, never commit real secrets)
JWT_SECRET=replace_with_a_secure_random_secret_min_32_chars

# JWT token expiration window (e.g. '7d', '24h', '1h')
JWT_EXPIRES_IN=7d

# Allowed Frontend Origin for CORS and cookie policy (e.g. 'http://localhost:5173' or production domain)
CLIENT_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# Frontend Configuration (frontend/.env)
# ------------------------------------------------------------------------------
# Base URL for REST API calls (omit to use Vite reverse proxy '/api/v1')
VITE_API_BASE_URL=http://localhost:5000/api/v1
